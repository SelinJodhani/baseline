<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- In-app updates from GitHub Releases (the user confirms each install). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- "Open Zepp" button: the watch syncs to the cloud through the Zepp phone app. -->
    <queries>
        <package android:name="com.huami.watch.hmwatchmanager" />
        <package android:name="com.xiaomi.hm.health" />
    </queries>

    <application
        android:name=".BaselineApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Baseline">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Baseline.Starting"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Pairing link printed by `baseline_bridge.py pair`: fills in the connect form. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="baseline" android:host="connect" />
            </intent-filter>
        </activity>

        <!-- Home-screen / lock-screen widgets (Glance). Refreshed by RefreshWorker and on app refresh. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/update_paths" />
        </provider>

        <receiver
            android:name=".widget.TodayWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_today">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_today_info" />
        </receiver>
        <receiver
            android:name=".widget.ReadinessWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_readiness">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_readiness_info" />
        </receiver>
        <receiver
            android:name=".widget.SleepWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_sleep">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_sleep_info" />
        </receiver>
        <receiver
            android:name=".widget.MoveWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_move">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_move_info" />
        </receiver>
    </application>
</manifest>
