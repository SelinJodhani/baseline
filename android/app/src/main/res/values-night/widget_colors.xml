<?xml version="1.0" encoding="utf-8"?>
<!-- Widget palette (before Android 12): the same Material 3 roles as values-night-v31, resolved from a tonal-spot palette seeded with Baseline's coral heart (#E8604C). -->
<resources>
    <!-- Card surface -->
    <color name="w_surface">#FF231918</color>
    <!-- Primary text on surfaces -->
    <color name="w_on_surface">#FFF1DFDB</color>
    <!-- Secondary text on surfaces -->
    <color name="w_on_surface_var">#FFD8C2BE</color>
    <!-- Progress track on surfaces -->
    <color name="w_track">#FF534341</color>
    <!-- Chip fill on surfaces -->
    <color name="w_chip">#FF5D3F3A</color>
    <!-- Text on chips -->
    <color name="w_on_chip">#FFFFDAD4</color>
    <!-- Primary accent: rings, indicators -->
    <color name="w_a1">#FFFFB4A7</color>
    <!-- Primary container (Readiness circle, verb chip) -->
    <color name="w_a1_container">#FF73342A</color>
    <!-- Text on primary container -->
    <color name="w_on_a1_container">#FFFFDAD4</color>
    <!-- Muted text on primary container -->
    <color name="w_on_a1_container_var">#FFFFB4A7</color>
    <!-- Track on primary container -->
    <color name="w_a1_track">#FF904B3F</color>
    <!-- Secondary container (Move) -->
    <color name="w_a2_container">#FF5D3F3A</color>
    <!-- Text on secondary container -->
    <color name="w_on_a2_container">#FFFFDAD4</color>
    <!-- Muted text on secondary container -->
    <color name="w_on_a2_container_var">#FFE7BDB6</color>
    <!-- Track on secondary container -->
    <color name="w_a2_track">#FF775651</color>
    <!-- Tertiary accent: sleep, active minutes -->
    <color name="w_a3">#FFDDC48C</color>
    <!-- Tertiary, softer (earlier nights) -->
    <color name="w_a3_mid">#FF8A7544</color>
    <!-- Tertiary container (Sleep) -->
    <color name="w_a3_container">#FF564419</color>
    <!-- Text on tertiary container -->
    <color name="w_on_a3_container">#FFFBE0A6</color>
    <!-- Muted text on tertiary container -->
    <color name="w_on_a3_container_var">#FFDDC48C</color>
    <!-- Track on tertiary container -->
    <color name="w_a3_track">#FF6F5C2E</color>
    <!-- Deep sleep: primary -->
    <color name="w_stage_deep">#FFFFB4A7</color>
    <!-- Light sleep: a lighter primary -->
    <color name="w_stage_light">#FF73342A</color>
    <!-- REM sleep: tertiary -->
    <color name="w_stage_rem">#FFC1A973</color>
    <!-- Awake: outline (neutral) -->
    <color name="w_stage_awake">#FFA08C89</color>
    <!-- Level: great = primary -->
    <color name="w_level_great">#FFFFB4A7</color>
    <!-- Level: good = primary, a step softer -->
    <color name="w_level_good">#FFEA9587</color>
    <!-- Level: caution = tertiary -->
    <color name="w_level_fair">#FFDDC48C</color>
    <!-- Level: needs rest = Material error -->
    <color name="w_level_low">#FFFFB4AB</color>
    <!-- Level: unknown = outline -->
    <color name="w_level_unknown">#FFA08C89</color>
    <!-- Alert: Material error container (same on every API level). -->
    <color name="w_alert_container">#FF8C1D18</color>
    <color name="w_on_alert_container">#FFFFDAD6</color>
</resources>
