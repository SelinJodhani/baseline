<?xml version="1.0" encoding="utf-8"?>
<!-- Styles for the static widget-picker preview layouts (res/layout/widget_preview_*). -->
<resources>
    <style name="WidgetPreviewChip">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/wshape_pill</item>
        <item name="android:backgroundTint">@color/w_chip</item>
        <item name="android:drawableStart">@drawable/wdot_great</item>
        <item name="android:drawablePadding">5dp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">9dp</item>
        <item name="android:paddingEnd">9dp</item>
        <item name="android:textColor">@color/w_on_chip</item>
        <item name="android:textSize">11sp</item>
    </style>

    <style name="WidgetPreviewSignalRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">22dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
    </style>

    <style name="WidgetPreviewSignalLabel">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:drawablePadding">8dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textColor">@color/w_on_surface_var</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="WidgetPreviewSignalValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/w_on_surface</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
