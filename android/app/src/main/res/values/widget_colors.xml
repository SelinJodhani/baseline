<?xml version="1.0" encoding="utf-8"?>
<!-- Widget palette (before Android 12): the same Material 3 roles as values-v31, resolved from a tonal-spot palette seeded with Baseline's coral heart (#E8604C). -->
<resources>
    <!-- Card surface -->
    <color name="w_surface">#FFFFEDEA</color>
    <!-- Primary text on surfaces -->
    <color name="w_on_surface">#FF231918</color>
    <!-- Secondary text on surfaces -->
    <color name="w_on_surface_var">#FF534341</color>
    <!-- Progress track on surfaces -->
    <color name="w_track">#FFFFDAD4</color>
    <!-- Chip fill on surfaces -->
    <color name="w_chip">#FFFFDAD4</color>
    <!-- Text on chips -->
    <color name="w_on_chip">#FF2C1511</color>
    <!-- Primary accent: rings, indicators -->
    <color name="w_a1">#FF904B3F</color>
    <!-- Primary container (Readiness circle, verb chip) -->
    <color name="w_a1_container">#FFFFDAD4</color>
    <!-- Text on primary container -->
    <color name="w_on_a1_container">#FF3A0905</color>
    <!-- Muted text on primary container -->
    <color name="w_on_a1_container_var">#FF73342A</color>
    <!-- Track on primary container -->
    <color name="w_a1_track">#FFFFB4A7</color>
    <!-- Secondary container (Move) -->
    <color name="w_a2_container">#FFFFDAD4</color>
    <!-- Text on secondary container -->
    <color name="w_on_a2_container">#FF2C1511</color>
    <!-- Muted text on secondary container -->
    <color name="w_on_a2_container_var">#FF5D3F3A</color>
    <!-- Track on secondary container -->
    <color name="w_a2_track">#FFE7BDB6</color>
    <!-- Tertiary accent: sleep, active minutes -->
    <color name="w_a3">#FF6F5C2E</color>
    <!-- Tertiary, softer (earlier nights) -->
    <color name="w_a3_mid">#FFC1A973</color>
    <!-- Tertiary container (Sleep) -->
    <color name="w_a3_container">#FFFBE0A6</color>
    <!-- Text on tertiary container -->
    <color name="w_on_a3_container">#FF251A00</color>
    <!-- Muted text on tertiary container -->
    <color name="w_on_a3_container_var">#FF564419</color>
    <!-- Track on tertiary container -->
    <color name="w_a3_track">#FFDDC48C</color>
    <!-- Deep sleep: primary -->
    <color name="w_stage_deep">#FF904B3F</color>
    <!-- Light sleep: a lighter primary -->
    <color name="w_stage_light">#FFFFB4A7</color>
    <!-- REM sleep: tertiary -->
    <color name="w_stage_rem">#FF8A7544</color>
    <!-- Awake: a softened error (no system error palette before Android 14) -->
    <color name="w_stage_awake">#FFE8A49C</color>
    <!-- Level: great = primary -->
    <color name="w_level_great">#FF904B3F</color>
    <!-- Level: good = primary, a step softer -->
    <color name="w_level_good">#FFAD6256</color>
    <!-- Level: caution = tertiary -->
    <color name="w_level_fair">#FF6F5C2E</color>
    <!-- Level: needs rest = Material error -->
    <color name="w_level_low">#FFBA1A1A</color>
    <!-- Level: unknown = outline -->
    <color name="w_level_unknown">#FF857370</color>
    <!-- Alert: Material error container (same on every API level). -->
    <color name="w_alert_container">#FFFFDAD6</color>
    <color name="w_on_alert_container">#FF410002</color>
</resources>
