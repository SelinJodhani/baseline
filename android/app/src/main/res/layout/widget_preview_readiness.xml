<?xml version="1.0" encoding="utf-8"?>
<!-- Static picker preview (Android 12–14; 15+ uses generated Glance previews). Demo values only. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:layout_width="130dp"
        android:layout_height="130dp"
        android:layout_gravity="center"
        android:background="@drawable/wshape_circle"
        android:backgroundTint="@color/w_a1_container">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="10dp"
            android:importantForAccessibility="no"
            android:src="@drawable/wpreview_ring_readiness" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ready"
                android:textColor="@color/w_on_a1_container"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="78"
                android:textColor="@color/w_on_a1_container_var"
                android:textSize="12sp" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
