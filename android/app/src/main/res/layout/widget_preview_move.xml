<?xml version="1.0" encoding="utf-8"?>
<!-- Static picker preview (Android 12–14; 15+ uses generated Glance previews). Demo values only. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:layout_width="130dp"
        android:layout_height="130dp"
        android:layout_gravity="center"
        android:background="@drawable/wshape_circle"
        android:backgroundTint="@color/w_a2_container">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="14dp"
            android:importantForAccessibility="no"
            android:src="@drawable/wpreview_rings_move" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="6,240"
                android:textColor="@color/w_on_a2_container"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="96 min"
                android:textColor="@color/w_a3"
                android:textSize="10sp" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
